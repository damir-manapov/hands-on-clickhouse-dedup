{
  "name": "hands-on-clickhouse-dedup",
  "version": "0.1.0",
  "description": "Investigating deduplication strategies in ClickHouse on synthetic passenger data",
  "author": "Damir Manapov",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "compose:pull": "docker compose -f compose/docker-compose.yml pull",
    "compose:up": "docker compose -f compose/docker-compose.yml up starter --wait",
    "compose:down": "docker compose -f compose/docker-compose.yml down",
    "compose:restart": "docker compose -f compose/docker-compose.yml restart",
    "compose:reset": "docker compose -f compose/docker-compose.yml down -v --remove-orphans",
    "generate": "tsx scripts/generate-passengers.ts",
    "bench": "tsx scripts/bench-queries.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "biome:migrate": "biome migrate --write",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.3",
    "@mkven/name-dictionaries": "^0.2.0",
    "@mkven/samples-generation": "^0.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/node": "^25.2.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "bash all-checks.sh"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  }
}
